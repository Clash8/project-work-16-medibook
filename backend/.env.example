APP_NAME=MediBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base dati -------------------------------------------------------------
# Configurazione di riferimento del progetto: MySQL.
# Per una prova rapida senza server MySQL e sufficiente impostare
# DB_CONNECTION=sqlite e creare il file database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medibook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Front-end / CORS ------------------------------------------------------
# Origini autorizzate a consumare le API (front-end React in sviluppo).
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

MAIL_MAILER=log
